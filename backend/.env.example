# Backend environment variables
DEBUG=true
SECRET_KEY=change-me-in-production
DATABASE_URL=sqlite+aiosqlite:///./mpc_autofill.db
ALLOWED_ORIGINS=["http://localhost:3000"]

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/sources/google-drive/callback

# Google Service Account (for community drives)
GOOGLE_SERVICE_ACCOUNT_KEY_PATH=

# S3-compatible storage (e.g., MinIO, Cloudflare R2, AWS S3)
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_NAME=mpc-autofill-uploads
S3_PUBLIC_URL=http://localhost:9000/mpc-autofill-uploads
